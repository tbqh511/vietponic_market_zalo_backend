APP_NAME="Vietponic Testing"
APP_ENV=testing
APP_KEY=base64:MHN6bnRmY3BjbHBza252OHFqNXl5M2tqdmFiZ3k1Y28=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Dùng SQLite in-memory để test không cần database thật
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Queue chạy đồng bộ để job dispatch trong test có thể verify ngay
QUEUE_CONNECTION=sync

CACHE_DRIVER=array
SESSION_DRIVER=array
MAIL_MAILER=array

# ─── Zalo Checkout SDK ────────────────────────────────────────────────────────
# Secret dùng để tính MAC trong prepareOrder() và CheckPaymentStatus job
ZALO_CHECK_OUT_SECRET=test_checkout_secret_key_for_testing

# Secret dùng để xác thực MAC trong webhook notifySDK()
ZALO_APP_SECRET=test_app_secret_for_testing

# ─── Admin API ────────────────────────────────────────────────────────────────
# Header X-Admin-Secret dùng trong ZaloAdminApiMiddleware
ADMIN_API_SECRET=test_admin_secret_for_testing

# ─── Zalo Open API (không gọi thật trong test – dùng Http::fake()) ─────────
ZALO_API_BASE_URL=https://openapi.zalo.me
