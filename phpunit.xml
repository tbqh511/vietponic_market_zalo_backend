<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         stopOnFailure="false">
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
        <!-- Testsuite riêng cho toàn bộ luồng Zalo Checkout SDK -->
        <testsuite name="Zalo">
            <file>./tests/Unit/ZaloMacCalculationTest.php</file>
            <file>./tests/Feature/AuthenticateTest.php</file>
            <file>./tests/Feature/PrepareOrderTest.php</file>
            <file>./tests/Feature/ZaloNotifyTest.php</file>
            <file>./tests/Feature/CheckPaymentStatusJobTest.php</file>
            <file>./tests/Feature/CancelUnpaidOrderTest.php</file>
            <file>./tests/Feature/UpdateOrderStatusTest.php</file>
            <file>./tests/Feature/OrderListTest.php</file>
        </testsuite>
        <!-- Testsuite cho Farm Partner -->
        <testsuite name="Farm">
            <file>./tests/Feature/FarmHubTest.php</file>
        </testsuite>
        <!-- Testsuite cho luồng tính cước vận chuyển + chọn trạm VTP -->
        <testsuite name="Shipping">
            <directory suffix="Test.php">./tests/Feature/Shipping</directory>
            <file>./tests/Feature/ShippingEstimateTest.php</file>
        </testsuite>
        <!-- Testsuite cho VTP webhook + create-order flow -->
        <testsuite name="VtpOrder">
            <file>./tests/Feature/ViettelPostWebhookTest.php</file>
            <file>./tests/Feature/VtpCreateOrderTest.php</file>
        </testsuite>
        <!-- Testsuite cho hệ thống Affiliate -->
        <testsuite name="Affiliate">
            <file>./tests/Unit/AffiliateCommissionCalculationTest.php</file>
            <file>./tests/Unit/AffiliateCodeGeneratorTest.php</file>
            <file>./tests/Feature/AffiliateRegistrationTest.php</file>
            <file>./tests/Feature/ApplyReferralTest.php</file>
            <file>./tests/Feature/CommissionCreditedOnPaymentTest.php</file>
            <file>./tests/Feature/CommissionOnDeliveryTest.php</file>
            <file>./tests/Feature/CommissionClawbackOnCancelTest.php</file>
        </testsuite>
        <!-- Testsuite cho Zalo OA / ZNS push notification -->
        <testsuite name="Notify">
            <file>./tests/Unit/ZaloOaClientTest.php</file>
            <file>./tests/Feature/ZaloNotificationTest.php</file>
        </testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </coverage>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:MHN6bnRmY3BjbHBza252OHFqNXl5M2tqdmFiZ3k1Y28="/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- Zalo Checkout SDK secret – dùng trong calculateMac() và CheckPaymentStatus job -->
        <env name="ZALO_CHECK_OUT_SECRET" value="test_checkout_secret_key_for_testing"/>
        <!-- Zalo App secret – dùng để xác thực webhook notifySDK() -->
        <env name="ZALO_APP_SECRET" value="test_app_secret_for_testing"/>
        <!-- Admin API secret – dùng trong ZaloAdminApiMiddleware -->
        <env name="ADMIN_API_SECRET" value="test_admin_secret_for_testing"/>
        <!-- JWT secret – dùng để ký và xác minh Bearer tokens trong OrderListTest -->
        <env name="JWT_SECRET" value="test_jwt_secret_for_testing_orders_list"/>
        <!-- Zalo OA / ZNS notification – bật cờ + template id giả cho test -->
        <env name="ZALO_NOTIFY_ENABLED" value="true"/>
        <env name="ZALO_OA_ID" value="test_oa"/>
        <env name="ZALO_OA_SECRET_KEY" value="test_oa_secret"/>
        <env name="ZALO_ZNS_TEMPLATE_PAID" value="tpl_paid"/>
        <env name="ZALO_ZNS_TEMPLATE_STATUS" value="tpl_status"/>
        <env name="ZALO_ZNS_TEMPLATE_CANCELLED" value="tpl_cancelled"/>
        <env name="ZALO_ZNS_TEMPLATE_SHIPPING" value="tpl_shipping"/>
    </php>
</phpunit>
